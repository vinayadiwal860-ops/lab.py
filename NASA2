                    {activeTab === 'overview' && (
                      <div className="space-y-3 text-xs font-mono">
                        <div className="flex justify-between py-1 border-b border-white/5"><span className="text-gray-400">Diameter:</span> <span className="text-white">{selectedPlanet.diameter}</span></div>
                        <div className="flex justify-between py-1 border-b border-white/5"><span className="text-gray-400">Distance:</span> <span className="text-white">{selectedPlanet.distance}</span></div>
                        <div className="flex justify-between py-1 border-b border-white/5"><span className="text-gray-400">Surface Temp:</span> <span className="text-white">{selectedPlanet.surfaceTemp}</span></div>
                      </div>
                    )}

                    {activeTab === 'science' && (
                      <div className="space-y-2">
                        {selectedPlanet.facts.map((fact, idx) => (
                          <div key={idx} className="flex items-start space-x-2 bg-white/5 p-2.5 rounded-lg border border-white/5">
                            <ChevronRight className="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" />
                            <span className="text-xs text-gray-300 leading-relaxed">{fact}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    {activeTab === 'missions' && (
                      <div className="space-y-2">
                        {selectedPlanet.missions.map((mission, idx) => (
                          <div key={idx} className="flex items-center space-x-2 bg-cyan-500/10 p-2.5 rounded-lg border border-cyan-500/20">
                            <Rocket className="w-4 h-4 text-cyan-400 shrink-0" />
                            <span className="text-xs text-cyan-300 font-mono">{mission}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </motion.div>
              )}
            </AnimatePresence>

          </div>
        )}
      </AnimatePresence>

      {/* VIEW 3: MISSION CONTROL */}
      <AnimatePresence>
        {currentView === 'mission' && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className="absolute inset-x-0 top-20 bottom-0 z-10 p-6 overflow-y-auto bg-black/80 backdrop-blur-xl">
            <div className="max-w-6xl mx-auto space-y-6">
              <h2 className="text-2xl font-bold">MISSION CONTROL & TELEMETRY</h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div className="bg-white/5 border border-white/10 p-5 rounded-2xl">
                  <span className="text-xs font-mono text-cyan-400">SOLAR ACTIVITY</span>
                  <div className="text-2xl font-bold mt-2">C-Class Flare</div>
                  <p className="text-xs text-gray-400 mt-2">Normal background solar wind flux detected.</p>
                </div>
                <div className="bg-white/5 border border-white/10 p-5 rounded-2xl">
                  <span className="text-xs font-mono text-cyan-400">NEAR EARTH OBJECTS</span>
                  <div className="text-2xl font-bold mt-2">3 Asteroids Tracked</div>
                  <p className="text-xs text-gray-400 mt-2">Safe trajectories within lunar distance.</p>
                </div>
                <div className="bg-white/5 border border-white/10 p-5 rounded-2xl">
                  <span className="text-xs font-mono text-cyan-400">DEEP SPACE NETWORK</span>
                  <div className="text-2xl font-bold mt-2">Goldstone Antenna 3</div>
                  <p className="text-xs text-gray-400 mt-2">Signal locked with Voyager & Mars Rover.</p>
                </div>
              </div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* VIEW 4: ASTEROIDS */}
      <AnimatePresence>
        {currentView === 'asteroids' && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className="absolute inset-x-0 top-20 bottom-0 z-10 p-6 overflow-y-auto bg-black/80 backdrop-blur-xl">
            <div className="max-w-6xl mx-auto space-y-6">
              <h2 className="text-2xl font-bold">NEAR-EARTH ASTEROID DATABASE</h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                {[{name: '(2024 PT4)', size: '45m', dist: '1.2M km'}, {name: 'Apophis (99942)', size: '370m', dist: '31M km'}, {name: 'Bennu (101955)', size: '492m', dist: '45M km'}].map((ast, i) => (
                  <div key={i} className="bg-white/5 border border-white/10 p-5 rounded-2xl">
                    <div className="text-lg font-bold text-cyan-400">{ast.name}</div>
                    <div className="text-xs text-gray-300 mt-2">Diameter: {ast.size}</div>
                    <div className="text-xs text-gray-400 mt-1">Miss Distance: {ast.dist}</div>
                  </div>
                ))}
              </div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* VIEW 5: COSMO AI */}
      <AnimatePresence>
        {currentView === 'ai' && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className="absolute inset-x-0 top-20 bottom-0 z-10 p-6 overflow-y-auto bg-black/80 backdrop-blur-xl flex flex-col items-center">
            <div className="max-w-2xl w-full flex-1 flex flex-col justify-between pb-10">
              <h2 className="text-2xl font-bold mb-4">COSMO AI SPACE ASSISTANT</h2>
              <div className="bg-white/5 border border-white/10 p-4 rounded-2xl flex-1 flex flex-col justify-between">
                <div className="space-y-4">
                  <div className="bg-cyan-500/10 border border-cyan-500/30 p-3 rounded-xl max-w-lg">
                    <div className="text-xs font-mono text-cyan-400 mb-1">COSMO AI</div>
                    <p className="text-xs text-gray-200">Greetings explorer! What would you like to discover about the cosmos today?</p>
                  </div>
                </div>
                <div className="mt-4 pt-4 border-t border-white/10 flex gap-2">
                  <input type="text" placeholder="Ask about planets, stars, or missions..." className="flex-1 bg-black/50 border border-white/20 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-cyan-400" />
                  <button className="px-6 py-3 rounded-xl bg-cyan-500 text-black font-bold text-xs hover:scale-105 transition">SEND</button>
                </div>
              </div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

    </div>
  );
}
